/* ==UserStyle==
@name           Fallen London Compact UI
@namespace      http://www.fallenlondon.com
@version        2.1.0
@description    A Fallen London userstyle with several options that compact the UI, particularly the sidebar and the main gamespace.
@author         Sacchi Hikaru
@preprocessor stylus

@var select sidebar-quality-number     "Number of Side-by-Side Qualities" {
 "Two (Default)": "default",
 "Three": "wide",
 "Four": "bigwide"
}

@var checkbox widen-game "Widen Primary Column" 0
@var checkbox doubled-slets "Doubled Storylet & Branches" 0
@var checkbox remove-mw "Remove Making Waves" 0
@var checkbox center-deck "Center Opportunity Deck (Requires Doubled Storylet/Branches)" 0
@var checkbox no-diff "Disable Challenge Difficulty Display" 0
@var checkbox slet-tweaks "Storylet/Branch Tweaks" 0
@var checkbox small-images "Small Storylet/Branch Images" 0
@var checkbox SM-EPA-integrated "Small Mercies EPA Tracker Integrated" 0
@var checkbox fl-timekeeper "FL Time Keeper Compatibility" 0

--- Options for the original Compact Wardrobe start here ---

@var checkbox   compact-menu    "Compact Outfit Controls (Mobile)" 0
@var number     categories-nr   "Items in last equipment row"  5
@var range       category-size   "Equipment Category Font Size"  [16, 12, 16, .5, 'px']

==/UserStyle==*/

/* No LLMs, so called "AIs" or similar immoral bullshit was used in the making of this stylesheet. This was the product of months of personal learning, research, work, and the help of fellow unhinged FL players and CSS touchers. Credit goes in particular to Patyn for pratically carrying me through the Doubled Storylets/Branches option.*/


@-moz-document domain("www.fallenlondon.com") {

    /* Primary Changes */

    /* Shortens the margin to the left of the whole main game screen, making the main game column larger by pushing the left sidebar a little. It's a tiny change and should only affect 720p screens, not 1080p ones.*/
    .general-container__row {
        margin-left: .5rem;
    }

    /* Shortens the space after pieces of text. Saves a surprising amount of vertical space.*/
    p {
        margin-bottom: .3em;
    }

    /* Shortens the space between just about everything in the main screen. Minor tweak, but saves a surprising amount of vertical space.*/
    .media {
        margin-top: .5rem !important;
    }

    /* This is one of the primary changes, making sure that the sidebars are large enough to accomodate doubled stats.*/
    .col-secondary,
    .col-tertiary {
        max-width: 205px;
        margin-top: 0px;
        padding-top: 5px !important;
    }

    /* Disables the "Make Contacts" Snippet on the right sidebar.*/
    .snippet,
    .items--list .item__desc .button--secondary {
        display: none;
    }

    /* Disables the "Enhanced your Subscription" text.*/
    .enhanced-text--inverse {
        display: none;
    }

    /* Increases the font size and bolds all sidebar numeric text for better visibility. */
    .items .item__desc .item__value {
        padding-top: 5px;
        font-weight: bold;
        font-size: 16px;
    }

    /* I'm not 100% sure what this one does but I think it's a vestige from when I couldn't figure out how to hide the text next to the fate button.*/
    .item__desc p {
        margin-top: 0px;
        margin-bottom: 0px;
        font-size: 14px;
        font-weight: bold;
    }

    /* Realigning the text on Echoes.*/
    .item__value .item__price {
        padding-top: 9px;
    }

    /* Reduces the margin on the sidebars, making them get closer to the central game screen. */
    .col-primary {
        margin-left: 0.5rem;
        margin-right: 0.5rem;
    }

    /* Makes sure all the sidebar items are neatly snug against each other and not leaving a ton of empty vertical space.*/
    .items--list .item {
        padding-top: 4px !important;
        /* EXTENSION INTEGRATION -- Marked Important to avoid conflict with Small Mercies "Remove progress bars from maxed-out sidebar qualities."*/
        padding-bottom: 4px;
        margin-top: 0px !important;
        /* EXTENSION INTEGRATION -- Marked Important to avoid conflict with Small Mercies "Remove progress bars from maxed-out sidebar qualities."*/
    }

    /* This makes the sidebar qualities stay side-by-side, greatly saving space.*/
    .items--list .sidebar-quality {
        max-width: 50%;
        min-width: 50%;
        float: left;
    }

    /* Hides all quality names and progress bars in the sidebars. */
    .sidebar .item__desc .item__name,
    .sidebar-quality .progress-bar {
        display: none;
    }

    /* Casts Yeetus Deletus on the subscription text next to the fate button on the sidebar. Includes hiding the "time left to renew" text.*/
    .sidebar__fate-button + .item__desc h3,
    .sidebar__fate-button + .item__desc p {
        display: none;
    }

    /* Realigns the value on the fate button. */
    .sidebar__fate-button + .item__desc .item__value {
        padding-top: 8px;
    }

    /* Makes images on the sidebars smaller, so they can better fit and take less space.*/
    .sidebar-quality img {
        width: 80%;
        height: 80%;
    }

    /* Resizes the sidebar images for Echoes, actions and the fate button.*/
    .icon--currency img {
        width: 80%;
        height: auto;
    }

    /* Realigns the text next to the Echoes a little bit.*/
    .sidebar__echoes-button {
        margin-right: -5px;
    }

    /* If you do not use this an ugly ass white bar will show up next to the fate button. I have been fighting this white bar for ages and this, combined with the transform a couple lines below, is the only solution I have found.*/
    .sidebar__fate-button img {
        width: 100%;
        height: auto;
    }

    /* This ensures that the text for the bonuses on your qualities is also clearly visible. */
    .sidebar-quality .item__desc {
        font-size: 16px;
        font-weight: bold;
    }

    /* Realigns the text on the sidebar qualities to the center. */
    .sidebar-quality .item__desc {
        margin: auto;
    }

    /* Realigns a lot of the remaining text. Will functionally not work without it. */
    .col-secondary .items--list .icon,
    .col-tertiary .items--list .icon {
        margin-right: -4px
    }

    /* Makes the central gameplay storylets a little bit closer to each other.*/
    .media {
        margin-top: 10px;
    }

    /* The only fix I was able to find that makes the sidebar fate button smaller without the white bar. It does not look perfect but I have vanquished that white bar for good. */
    .col-secondary .item .sidebar__fate-button {
        transform: scale(0.85);
        margin-left: -6px;
        margin-top: -12px;
    }

    /* Makes the right sidebar closer to the travel button.*/
    #right-sidebar {
        margin-top: .5rem !important;
    }

    /* Removes some unnecessary linebreaks on the right sidebar.*/
    .travel br {
        display: none;
    }

    /* The above removes unnecessary linebreaks. This one adds a very specific necessary one back.*/
    .travel .heading--3 br {
        display: initial !important;
    }

    /* Disables all known sidebar ads. */
    .col-tertiary .col-1-of-3 .travel a img {
        display: none;
    }

    /* EXTENSION INTEGRATION -- This SHOULD only do anything if you have the Small Mercies EPA Tracker enabled. It will align the EPA Numbers with the icon.*/
    .col-secondary .items--list .item div .item__value .item__price:has(span) {
        padding-top: 0px;
        margin-left: 5px;
    }

    /* EXTENSION INTEGRATION -- This SHOULD only do anything if you have the Small Mercies EPA Tracker enabled. It will realign the text and options to use the space a little better without increasing its vertical size. Still kind of an ugly WIP.*/
    .col-secondary .items--list .item div .item__value .item__price br + span {
        position: absolute;
        top: 49%;
        left: 0;
    }

    .col-secondary .items--list .item div .item__value .item__price br + a {
        position: absolute;
        top: 65%;
        left: 0;
    }

    .col-secondary .items--list .item div .item__value .item__price a {
        position: absolute;
        top: 66%;
        left: 21.5%;
    }

    /* TOGGLABLE -- Doubles storylets and branches on the main gamespace, allowing them to show up side-by-side. This code was kindly provided by Platyn, who solved my months of occasional css research on doing this in about 5 minutes. Contains only incredibly minor tweaks to account for specific UI bugs.*/
    if(doubled-slets) {
        /* These two together do most of the magic, in allowing the storylets to be side-by-side and automatically change height based on whichever storylet is the taller one.*/
        .tab-content__bordered-container, .disclosure-children, .agent-report-branch-container {
            display: flex;
            flex-wrap: wrap;
        }
        .media--branch,
        .media.storylet,
        .persistent {
            width: calc(50% - 0.5rem);
            margin-left: .5rem;
        }
    
        /* This one ensures several things, such as storylet and result text, the buttons and requirements, agent reports and assignments, the fifth city stories, sell dialogue, possessions tab (only when searching for some reason???), and fate stories are still the full size of the gamespace. Also fixes a bug when deleting entries from the journal.*/
        .buttons,
        .media--root,
        .disclosure-wrapper,
        .tab-content__bordered-container div:has(.media--root + .media--quality-updates),
        .media--root div:has(.modal__body),
        .tab-content__bordered-container div:has(.agent-report),
        .tab-content__bordered-container div:has(.agent-assign-view),
        .tab-content__bordered-container div:has(span div .row .shop__item),
        .modal-dialog__overlay .media--root div:has(>.exchange-ui__header),
        .tab-content__bordered-container div:has(.possessions),
        .fate-cards .fate-card--story,
        .fate-header__subscription-container .storylet,
        .tab-content__bordered-container .fate-card{
            width: 100%;
        }
        
        /* Places the Spinning Hat Loading Image back on the center of the screen. Fix graciously provided by Platyn*/
        div:has(>span>.loading-image){
            width:100%
        }
        
        /* KEEP THIS FOR LATER. I'M EEPY.
        
            .agent-summary{
                grid-template-columns: auto 30rem;
            }
            
            ^^ This is the option that determines the length of the left side of the agent stats.*/
    }

    /* TOGGLABLE -- Makes the primary game space as large as it can be without digging into the sidebars. This prevents the empty space to the left and right of the sidebars. */
    if(widen-game) {
        .col-primary {
            max-width: 2000px;
        }
    }

    /* TOGGLABLE -- Hides Making Waves from the sidebar entirely, for those of us who are utterly done with Notability grinding and do not want to think about Making Waves anymore. This is option exists entirely out of spite. */
    if (remove-mw) {
        .col-secondary .items--list :has(img[src="//images.fallenlondon.com/icons/sidebarmakingwavessmall.png"]) {
            display: none;
        }
    }

    /* TOGGLABLE -- Centers the Opportunity Deck. Particularly useful when used alongside "Widen Primary Column. " */
    if (center-deck) {
        .cards {
            margin: auto;
            width: unset;
        }
    }

    /* TOGGLABLE -- Disables the messages such as "This is a Straightforward challenge." can reduce visual clarity for what is vs isn't a 100% chance check, but does save some vertical space.*/
    if(no-diff) {
        .challenge__heading {
            display: none;
        }
    }

    /* TOGGLABLE -- Several tweaks to the layout of branches and storylets, generally making them take less vertical space and make better use of the space they have.*/
    if(slet-tweaks) {

        /* Makes the Plans button smaller and moves them to a better position to account for the new size. Also seamlessly integrates with FL Identica and FL One Click Wiki Extensions.*/
        .buttonlet-container {
            transform: scale(0.8);
            margin-left: -3px;
            margin-right: -3px;
            margin-top: -8px;
        }

        /* This makes the title of the storylets and branches larger. This was the only way I found to get the actual description texts to go all the way to the right instead of stopping midway. At least, without making the branch buttons so small as to look bad.*/
        .storylet__body .storylet__title-and-description .heading--3,
        .branch__body .branch__title {
            font-size: 18.6px;
        }
    }


    /* TOGGLABLE -- Makes the images on storylets and branches smaller to save on some vertical space.*/
    if(small-images) {

        /* This is the part that makes them smaller, while also shuffling them around to accommodate the new size.*/
        .storylet__left,
        .branch__left {
            transform: scale(0.8);
            margin-left: -10px;
            margin-right: 0;
            padding-right: 0px;
            margin-top: -10px;
        }
    }

    /* EXTENSION INTEGRATION -- Ensures that other changes in this stylesheet don't conflict with the FL Time Keeper Extension. TURNING THEM ON IF YOU DO NOT USE THE EXTENSION MIGHT CAUSE ISSUES.*/
    if(fl-timekeeper) {
        .cards + .storylet_favourite {
            width: 100% !important;
        }

        .cards + .storylet .storylet__body .storylet__title-and-description .heading--3 {
            font-size: 16.8px;
        }

        .cards + .media {
            margin-top: 10px !important;
            margin-bottom: 10px !important;
        }
    }

    /* SELECTABLE -- Further resizes the sidebars to allow for side-by-side currencies and three/four qualities side-by-side. Makes the outfit selector and view map button look silly. Only works for horizontal resolutions higher than 1500px (three) or 1900px (four). */
    if(sidebar-quality-number=='wide') {
        @media (min-width: 1500px) {
            .col-secondary .items--list .item {
                max-width: 50%;
                min-width: 50%;
                display: inline-flex;
            }

            .items--list .sidebar-quality {
                max-width: 33% !important;
                min-width: 33% !important;
                float: left !important;
                margin-right: 1px;
            }

            .col-secondary,
            .col-tertiary {
                max-width: 305px;
            }

            .col-secondary .css-13ab8kc-container,
            .col-secondary .css-1hs30sg-container {
                max-width: 100%;
            }

            .general-container__row {
                margin-left: .1rem;
            }

            if(SM-EPA-integrated) {
                /* EXTENSION INTEGRATION -- This SHOULD only do anything if you have the Small Mercies EPA Tracker enabled. It will make the EPA Tracker also go side-by-side on the curencies on the sidebar, It will realign the text and options to use the space a little better without increasing its vertical size. Still kind of an ugly WIP.*/
                .col-secondary .items--list div:has(.item) {
                    max-width: 50%;
                    min-width: 50%;
                    display: inline-flex;
                }
                .col-secondary .items--list .item div .item__value .item__price br + span {
                    position: absolute;
                    top: 50%;
                    left: 0;
                }

                .col-secondary .items--list .item div .item__value .item__price br + a {
                    position: absolute;
                    top: 65%;
                    left: 0;
                }

                .col-secondary .items--list .item div .item__value .item__price a {
                    position: absolute;
                    top: 66%;
                    left: 58%;
                }
            }
        }
    }

    if(sidebar-quality-number=='bigwide') {
        @media (min-width: 1900px) {
            .col-secondary .items--list .item {
                max-width: 50%;
                min-width: 50%;
                display: inline-flex;
            }
            .items--list .sidebar-quality {
                max-width: 25% !important;
                min-width: 25% !important;
                float: left !important;
            }
            .col-secondary,
            .col-tertiary {
                max-width: 405px;
            }
            .col-secondary .css-13ab8kc-container,
            .col-secondary .css-1hs30sg-container {
                max-width: 100%;
            }
            .general-container__row {
                margin-left: .1rem;
            }

            if(widen-game) {
                .col-primary {
                    max-width: 1080px;
                }
            }

            if(SM-EPA-integrated) {
                /* EXTENSION INTEGRATION -- This SHOULD only do anything if you have the Small Mercies EPA Tracker enabled. It will make the EPA Tracker also go side-by-side on the curencies on the sidebar, and move the text around a bit to prevent potential issues when total echoes and actions is too high.*/
                .col-secondary .items--list div:has(.item) {
                    max-width: 50%;
                    min-width: 50%;
                    display: inline-flex;
                }
                .col-secondary .items--list .item div .item__value .item__price br + span {
                    position: absolute;
                    top: 50%;
                    left: 0;
                }

                .col-secondary .items--list .item div .item__value .item__price br + a {
                    position: absolute;
                    top: 65%;
                    left: 0;
                }

                .col-secondary .items--list .item div .item__value .item__price a {
                    position: absolute;
                    top: 66%;
                    left: 58%;
                }
            }
        }
    }
}
@-moz-document domain("www.fallenlondon.com") {

    /* Myself Tab */

    /* On the "myself" page, makes me Mantelpiece/Scrapbook bar be next to the Cameo & Lodgings images.*/
    .myself-profile__cameo-and-lodgings {
        float: left;
        margin-bottom: 3px;
    }

    /* These next three are just making sure the Cameo & Lodgings are as compact as possible on the myself page. */
    .myself-profile__cameo-border {
        margin-right: 3px;
    }

    .myself-profile__lodgings-container {
        margin-left: 0px;
    }

    .myself-profile__lodgings-border {
        margin-right: 0px;
    }

    /* These three lines change the text of the Journal and Profile buttons on the myself page to make sure they don't take two lines. */
    .myself-profile__view-and-set-private .button--no-margin {
        text-indent: -99999px;
        line-height: 0px;
    }

    .myself-profile__view-and-set-private .button--no-margin::after {
        content: "Journal";
        text-indent: 0;
        line-height: initial;
        display: block;
    }

    .myself-profile__view-and-set-private a[href*="/profile/"]::after {
        content: "Profile";
        text-indent: 0;
        line-height: initial;
        display: block;
    }

    /* If you have the Change Face option below your cameo from using the Liber Visionis, this will move it closer to the cameo itself, saving some vertical space. */
    .u-space-above.myself-profile__button--change-face {
        margin-top: .1rem;
    }

    /* Reduces the margin from the bottom of the myself page's search bar.*/
    .input--item-search {
        margin-bottom: .1rem;
        margin-top: .5rem;
    }

    /* Reduces the padding from all of the qualities in the myself page. */
    .quality-item {
        padding-top: .1rem;
        padding-bottom: .1rem;
    }

    /* These next two are here to make the cameo/lodgings/mantelpiece/scrapbook take more horizontal space without increasing the size of the central game space. Also gives more space to the qualities themselves.  */
    .nav--stacked--1-of-4 {
        width: 17.833%;
    }

    .stack-content--3-of-4 {
        margin-left: 1.083%;
        padding-right: 0rem;
        padding-left: 1.083%;
        width: 81.083%;
    }
}
@-moz-document domain("www.fallenlondon.com") {
    
    /* Possessions Tab */
    
    /* Compact Wardrobe Stylesheet, ported over to this one with permission from original creator Platyn. Original code and contributions go directly to them.*/
    
	/** all rows are turned into full width flex elements **/
	.equipment-group-list {
		display: flex;
		flex-wrap: wrap;
	}
	.equipment-group-list__item {
		width: 100%;
	}

	/** boons & burdens, treasures & tools of trade are collapsed to one row if both in a pair are present **/
	.equipment-group-list:has(.equipment-group-list__item:nth-child(2) .equipment-group) .equipment-group-list__item:nth-child(1),
	.equipment-group-list:has(.equipment-group-list__item:nth-child(13) .equipment-group) .equipment-group-list__item:nth-child(11) {
		width: calc(50% - 5px);
		margin-right: 10px;
	}
	.equipment-group-list:has(.equipment-group-list__item:nth-child(1) .equipment-group) .equipment-group-list__item:nth-child(2),
	.equipment-group-list:has(.equipment-group-list__item:nth-child(11) .equipment-group) .equipment-group-list__item:nth-child(13) {
		width: calc(50% - 5px);
	}

	/** all unchangable item categories are collapsed into the last row **/
	.equipment-group-list__item:has(.equipment-group__equipment-slot-container--unchangeable) {
		width: "calc((100% + 10px)/%s - 10px)" % categories-nr;
		margin-right: 10px;
		order: 1;
	}
	.equipment-group-list__item:has(.equipment-group__equipment-slot-container--unchangeable):last-of-type {
		margin-right: 0;
	}
	.available-item-list:not(:has(.available-item-list__item)) {
		display: none;
	}

	/** optional change to category title font size **/
	.equipment-group__name {
		font-size: category-size;
	}

	if (compact-menu) {
		/** makes all controls shorter **/
		.outfit-controls-container .css-13ab8kc-container,
		.outfit-controls-container .css-1hs30sg-container,
		.outfit-controls--locked,
		.outfit-controls__search-field {
			max-width: 14rem;
		}
		.outfit-controls__outfit-rename-field {
			min-width: 14rem;
			margin-right: 44.8px;
		}
		/** switches informational text to one word only **/
		.outfit-controls-container .button,
		.outfit-controls__save-outfit-success-message span {
			font-size: 0;
		}
		.outfit-controls-container .button:after {
			content: "Equip";
			font-size: 13px;
		}
		.outfit-controls__save-outfit-success-message {
			right: 0;
		}
		.outfit-controls__save-outfit-success-message span:after {
			content: "Updated";
			font-size: 14px;
		}
	}
}
