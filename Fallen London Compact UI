    .col-secondary, .col-tertiary { max-width: 390px;}
    .css-13ab8kc-container { max-width: 100%;}
    .col-primary { max-width: 1080px; }
}*/
}
@-moz-document url-prefix("https://www.fallenlondon.com/myself") {

    /* On the "myself" page, makes me Mantelpiece/Scrapbook bar be next to the Cameo & Lodgings images.*/
    .myself-profile__cameo-and-lodgings {
        float: left;
        margin-bottom: 3px;
    }

    /* These next three are just making sure the Cameo & Lodgings are as compact as possible on the myself page. */
    .myself-profile__cameo-border {
        margin-right: 3px;
    }

    .myself-profile__lodgings-container {
        margin-left: 0px;
    }

    .myself-profile__lodgings-border {
        margin-right: 0px;
    }

    /* These three lines change the text of the Journal and Profile buttons on the myself page to make sure they don't take two lines. */
    .myself-profile__view-and-set-private .button--no-margin {
        text-indent: -99999px;
        line-height: 0px;
    }

    .myself-profile__view-and-set-private .button--no-margin::after {
        content: "Journal";
        text-indent: 0;
        line-height: initial;
        display: block;
    }

    .myself-profile__view-and-set-private a[href*="/profile/"]::after {
        content: "Profile";
        text-indent: 0;
        line-height: initial;
        display: block;
    }

    /* If you have the Change Face option below your cameo from using the Liber Visionis, this will move it closer to the cameo itself, saving some vertical space. */
    .u-space-above.myself-profile__button--change-face {
        margin-top: .1rem;
    }

    /* Reduces the margin from the bottom of the myself page's search bar.*/
    .input--item-search {
        margin-bottom: .1rem;
    }

    /* Reduces the padding from all of the qualities in the myself page. */
    .quality-item {
        padding-top: .1rem;
        padding-bottom: .1rem;
    }
}
