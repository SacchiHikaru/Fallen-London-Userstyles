/* ==UserStyle==
@name           Fallen London Compact UI
@namespace      http://www.fallenlondon.com
@version        1.4.2
@description    A Fallen London userstyle that compacts the UI, particularly the sidebar.
@author         Sacchi Hikaru
@preprocessor stylus

@var select sidebar-quality-number     "Number of Side-by-Side Qualities" {
 "Two (Default)": "default",
 "Three": "wide",
 "Four": "bigwide"
}

@var checkbox widen-game "Widen Primary Column" 0
@var checkbox remove-mw "Remove Making Waves" 0

==/UserStyle==*/
@-moz-document url-prefix("https://www.fallenlondon.com") {

    /* Shortens the margin to the left of the whole main game screen, making the main game column larger by pushing the left sidebar a little. It's a tiny change and should only affect 720p screens, not 1080p ones.*/
    .general-container__row {
        margin-left: .5rem;
    }


    /* This is one of the primary changes, making sure that the sidebars are large enough to accomodate doubled stats.*/
    .col-secondary,
    .col-tertiary {
        max-width: 205px;
        margin-top: 0px;
        padding-top: 5px !important;
    }

    /* Disables the "Make Contacts" Snippet on the right sidebar.*/
    .snippet,
    .items--list .item__desc .button--secondary {
        display: none;
    }

    /* Disables the "Enhanced your Subscription" text.*/
    .enhanced-text--inverse {
        display: none;
    }

    /* Increases the font size and bolds all sidebar numeric text for better visibility. */
    .items .item__desc .item__value {
        padding-top: 5px;
        font-weight: bold;
        font-size: 16px;
    }

    /* I'm not 100% sure what this one does but I think it's a vestige from when I couldn't figure out how to hide the text next to the fate button.*/
    .item__desc p {
        margin-top: 0px;
        margin-bottom: 0px;
        font-size: 14px;
        font-weight: bold;
    }

    /* Realigning the text on Echoes.*/
    .item__value .item__price {
        padding-top: 9px;
    }

    /* Reduces the margin on the sidebars, making them get closer to the central game screen. */
    .col-primary {
        margin-left: 0.5rem;
        margin-right: 0.5rem;
    }

    /* Makes sure all the sidebar items are neatly snug against each other and not leaving a ton of empty vertical space.*/
    .items--list .item {
        padding-top: 4px;
        padding-bottom: 4px;
        margin-top: 0px;
    }

    /* This makes the sidebar qualities stay side-by-side, greatly saving space.*/
    .items--list .sidebar-quality {
        max-width: 50%;
        min-width: 50%;
        float: left;
    }

    /* Hides all quality names and progress bars in the sidebars. */
    .sidebar .item__desc .item__name,
    .sidebar-quality .progress-bar {
        display: none;
    }

    /* Casts Yeetus Deletus on the subscription text next to the fate button on the sidebar. Includes hiding the "time left to renew" text.*/
    .sidebar__fate-button + .item__desc h3,
    .sidebar__fate-button + .item__desc p {
        display: none;
    }

    /* Realigns the value on the fate button. */
    .sidebar__fate-button + .item__desc .item__value {
        padding-top: 8px;
    }

    /* Makes images on the sidebars smaller, so they can better fit and take less space.*/
    .sidebar-quality img {
        width: 80%;
        height: 80%;
    }

    /* Resizes the sidebar images for Echoes, actions and the fate button.*/
    .icon--currency img {
        width: 80%;
        height: auto;
    }

    /* Realigns the text next to the Echoes a little bit.*/
    .sidebar__echoes-button {
        margin-right: -5px;
    }

    /* If you do not use this an ugly ass white bar will show up next to the fate button. I have been fighting this white bar for ages and this, combined with the transform a couple lines below, is the only solution I have found.*/
    .sidebar__fate-button img {
        width: 100%;
        height: auto;
    }

    /* This ensures that the text for the bonuses on your qualities is also clearly visible. */
    .sidebar-quality .item__desc {
        font-size: 16px;
        font-weight: bold;
    }

    /* Realigns the text on the sidebar qualities to the center. */
    .sidebar-quality .item__desc {
        margin: auto;
    }

    /* Realigns a lot of the remaining text. Will functionally not work without it. */
    .col-secondary .items--list .icon,
    .col-tertiary .items--list .icon {
        margin-right: -4px
    }

    /* Makes the central gameplay storylets a little bit closer to each other.*/
    .media {
        margin-top: 10px;
    }

    /* The only fix I was able to find that makes the sidebar fate button smaller without the white bar. It does not look perfect but I have vanquished that white bar for good. */
    .col-secondary .item .sidebar__fate-button {
        transform: scale(0.85);
        margin-left: -6px;
        margin-top: -12px;
    }

    /* Makes the right sidebar closer to the travel button.*/
    #right-sidebar {
        margin-top: .5rem !important;
    }

    /* Removes some unnecessary linebreaks on the right sidebar.*/
    .travel br {
        display: none;
    }

    /* The above removes unnecessary linebreaks. This one adds a very specific necessary one back.*/
    .travel .heading--3 br {
        display: initial !important;
    }

    /* Disables all known sidebar ads. */
    .col-tertiary .col-1-of-3 .travel a img {
        display: none;
    }

    /* TOGGLABLE -- Hides Making Waves from the sidebar entirely, for those of us who are utterly done with Notability grinding and do not want to think about Making Waves anymore. This is option exists entirely out of spite. */
    if (remove-mw) {
        .col-secondary .items--list :has(img[src="//images.fallenlondon.com/icons/sidebarmakingwavessmall.png"]) {
            display: none;
        }
    }
    
    if(widen-game) {
        .col-primary {
            max-width: 2000px;}
    }

    /* SELECTABLE -- Further resizes the sidebars to allow for side-by-side currencies and three/four qualities side-by-side. Makes the outfit selector and view map button look silly. Only works for horizontal resolutions higher than 1500px (three) or 1900px (four). */
    if(sidebar-quality-number=='wide') {
        @media (min-width: 1500px) {
            .col-secondary .items--list .item {
                max-width: 50%;
                min-width: 50%;
                display: inline-flex;
            }

            .items--list .sidebar-quality {
                max-width: 33% !important;
                min-width: 33% !important;
                float: left !important;
            }

            .col-secondary,
            .col-tertiary {
                max-width: 305px;
            }

            .col-secondary .css-13ab8kc-container,
            .col-secondary .css-1hs30sg-container {
                max-width: 100%;
            }

            .general-container__row {
                margin-left: .1rem;
            }
        }
    }

    if(sidebar-quality-number=='bigwide') {
        @media (min-width: 1900px) {
            .col-secondary .items--list .item {
                max-width: 50%;
                min-width: 50%;
                display: inline-flex;
            }
            .items--list .sidebar-quality {
                max-width: 25% !important;
                min-width: 25% !important;
                float: left !important;
            }
            .col-secondary,
            .col-tertiary {
                max-width: 405px;
            }
            .col-secondary .css-13ab8kc-container,
            .col-secondary .css-1hs30sg-container {
                max-width: 100%;
            }
            .general-container__row {
                margin-left: .1rem;
            }
            
            if(widen-game) {
                .col-primary {
                    max-width: 1080px;}
            }
        }
    }
}
@-moz-document url-prefix("https://www.fallenlondon.com/myself") {

    /* On the "myself" page, makes me Mantelpiece/Scrapbook bar be next to the Cameo & Lodgings images.*/
    .myself-profile__cameo-and-lodgings {
        float: left;
        margin-bottom: 3px;
    }

    /* These next three are just making sure the Cameo & Lodgings are as compact as possible on the myself page. */
    .myself-profile__cameo-border {
        margin-right: 3px;
    }

    .myself-profile__lodgings-container {
        margin-left: 0px;
    }

    .myself-profile__lodgings-border {
        margin-right: 0px;
    }

    /* These three lines change the text of the Journal and Profile buttons on the myself page to make sure they don't take two lines. */
    .myself-profile__view-and-set-private .button--no-margin {
        text-indent: -99999px;
        line-height: 0px;
    }

    .myself-profile__view-and-set-private .button--no-margin::after {
        content: "Journal";
        text-indent: 0;
        line-height: initial;
        display: block;
    }

    .myself-profile__view-and-set-private a[href*="/profile/"]::after {
        content: "Profile";
        text-indent: 0;
        line-height: initial;
        display: block;
    }

    /* If you have the Change Face option below your cameo from using the Liber Visionis, this will move it closer to the cameo itself, saving some vertical space. */
    .u-space-above.myself-profile__button--change-face {
        margin-top: .1rem;
    }

    /* Reduces the margin from the bottom of the myself page's search bar.*/
    .input--item-search {
        margin-bottom: .1rem;
        margin-top: .5rem;
    }

    /* Reduces the padding from all of the qualities in the myself page. */
    .quality-item {
        padding-top: .1rem;
        padding-bottom: .1rem;
    }

    /* These next two are here to make the cameo/lodgings/mantelpiece/scrapbook take more horizontal space without increasing the size of the central game space. Also gives more space to the qualities themselves.  */
    .nav--stacked--1-of-4 {
        width: 17.833%;
    }

    .stack-content--3-of-4 {
        margin-left: 1.083%;
        padding-right: 0rem;
        padding-left: 1.083%;
        width: 81.083%;
    }
}
